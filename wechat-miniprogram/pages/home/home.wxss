.page {
  min-height: 100vh;
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx;
}

.menu-item {
  width: 340rpx;
  box-sizing: border-box;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.mi-purple {
  background: #6d5efc;
}

.menu-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.menu-desc {
  margin-top: 4rpx;
}

.page {
  min-height: 100vh;
  padding: 16rpx 20rpx 32rpx;
  box-sizing: border-box;
}

.page.with-bar {
  padding-bottom: 280rpx;
}

.head .model,
.line-name {
  font-weight: 600;
}

.row-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.model {
  flex: 1;
  font-size: 32rpx;
}

.name,
.meta,
.note,
.line-2,
.line-3 {
  margin-top: 8rpx;
}

.note {
  color: #5c6370;
  font-size: 24rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.note.open {
  display: block;
  -webkit-line-clamp: unset;
}

.badge {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #4f46e5;
  background: #eef0ff;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.banner {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 24rpx;
}

.line {
  margin-top: 12rpx;
}

.line-1 {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.no {
  color: #8b919a;
  font-size: 22rpx;
  min-width: 32rpx;
}

.cat {
  color: #4f46e5;
  font-size: 22rpx;
  background: #eef0ff;
  border-radius: 8rpx;
  padding: 0 8rpx;
}

.line-name {
  flex: 1;
  font-size: 28rpx;
}

.line-3 {
  font-size: 24rpx;
  color: #1f2329;
}

.state {
  padding: 80rpx 24rpx;
  text-align: center;
}

.state-mark {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 20rpx;
  border-radius: 24rpx;
  background: #6d5efc;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.state-title {
  font-size: 30rpx;
  font-weight: 600;
}

.state-desc {
  margin-top: 12rpx;
}

.retry {
  display: inline-block;
  margin-top: 20rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #4f46e5;
  color: #fff;
  font-size: 26rpx;
}

.totals {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(20, 24, 40, 0.06);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

.cell {
  min-width: 30%;
}

.strong {
  color: #4f46e5;
  font-size: 32rpx;
  font-weight: 700;
}

.num {
  font-size: 26rpx;
  font-weight: 600;
}

.profit {
  width: 100%;
  font-size: 24rpx;
}
